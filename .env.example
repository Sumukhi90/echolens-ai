# Copy to .env for backend configuration. Keep secrets server-side.
DATABASE_URL=sqlite:///./echolens.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional Gemini integration. Each live request additionally requires user consent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LIVE_AI_ENABLED=false
# Optional local embeddings; model downloads on first use.
LOCAL_EMBEDDINGS_ENABLED=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional local audio transcription model; downloads on first use.
WHISPER_MODEL=base
